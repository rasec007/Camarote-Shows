{
  "name": "camarote-shows",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @camarote/shared build && pnpm --parallel --filter @camarote/server --filter @camarote/web --filter @camarote/mobile dev",
    "dev:server": "pnpm --filter @camarote/shared build && pnpm --filter @camarote/server dev",
    "dev:web": "pnpm --filter @camarote/shared build && pnpm --filter @camarote/web dev",
    "dev:mobile": "pnpm --filter @camarote/shared build && pnpm --filter @camarote/mobile dev",
    "build": "pnpm --filter @camarote/server --filter @camarote/shared --filter @camarote/web --filter @camarote/mobile -r --workspace-concurrency=1 build",
    "start": "pnpm --filter @camarote/server start",
    "lint": "pnpm --filter @camarote/server --filter @camarote/shared --filter @camarote/web --filter @camarote/mobile -r lint"
  },
  "packageManager": "pnpm@12.11.2"
}
