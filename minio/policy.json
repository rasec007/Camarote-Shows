{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::contratos", "arn:aws:s3:::financeiro", "arn:aws:s3:::rh", "arn:aws:s3:::arquivos"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::contratos/*", "arn:aws:s3:::financeiro/*", "arn:aws:s3:::rh/*", "arn:aws:s3:::arquivos/*"]
    }
  ]
}
