NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3333
DATABASE_URL=postgres://camarote:local_dev_only@localhost:5433/camarote_shows
POSTGRES_PORT=5433
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
WEB_ORIGIN=https://appcamaroteshows.com.br
MOBILE_ORIGIN=https://mobile.appcamaroteshows.com.br
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_COMPANY_NAME=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
MINIO_ROOT_USER=replace-with-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-admin-secret
S3_ACCESS_KEY=camarote-app
S3_SECRET_KEY=replace-with-a-separate-long-random-storage-secret
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=https://arquivos.appcamaroteshows.com.br
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAX_FILE_SIZE_BYTES=26214400
